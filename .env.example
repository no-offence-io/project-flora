# Copy to .env.local (git-ignored). Never commit real values.

# Stripe — test keys from https://dashboard.stripe.com/test/apikeys (Developer role is enough)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` in dev; from the webhook endpoint page in the dashboard for deployed envs
STRIPE_WEBHOOK_SECRET=whsec_...

# Sanity (project id and dataset are public identifiers, not secrets)
NEXT_PUBLIC_SANITY_PROJECT_ID=559r73zo
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only write token (Developer/Editor role) used by the Stripe webhook to record orders and
# adjust stock. A real secret: never NEXT_PUBLIC_, never passed to the browser.
# Create at https://www.sanity.io/manage -> project -> API -> Tokens.
SANITY_TOKEN=

# Coming-soon gate. "true" hides the whole site behind /coming-soon; anything else opens it.
COMING_SOON=false
# Visit any URL with ?preview=<this> to look past the gate. Server-side only, never NEXT_PUBLIC_.
PREVIEW_TOKEN=

# Admin login (Auth.js). Generate AUTH_SECRET with `npx auth secret`; the Google pair comes from
# Google Cloud Console (OAuth client, Web application; redirect URI <site>/api/auth/callback/google).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed into /admin. Everyone else is refused at sign-in.
ADMIN_EMAILS=

# Shared secret Sanity sends when it calls /api/revalidate after a publish, so edits show on the site
# without waiting for a browser to be open. Generate with `openssl rand -base64 24`.
REVALIDATE_SECRET=

# Email (Resend, https://resend.com). Without the key, nothing is sent and the admin says so.
RESEND_API_KEY=
# Sender. Needs the domain verified in Resend (Domains → add prosjectflora.com → DNS records at one.com).
# Until then leave empty: Resend's onboarding sender works, but only to the account owner's address.
EMAIL_FROM=Flöra <hello@prosjectflora.com>
# Optional: gets a copy of every order confirmation.
EMAIL_NOTIFY=

# Public address of the site, used in emails, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.prosjectflora.com

# Vipps MobilePay (ePayment). test → apitest.vipps.no with the test sales unit; production → api.vipps.no.
VIPPS_ENV=test
VIPPS_MSN=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
# Printed once by `node scripts/vipps-webhook.mjs register <url>`.
VIPPS_WEBHOOK_SECRET=

# Optional: a Viewer-role token for the storefront's reads, so the write token is used only where something is written.
# Falls back to SANITY_TOKEN.
SANITY_READ_TOKEN=

# Optional: Google Analytics numbers on the dashboard's Visits page. A service-account key (JSON) with Viewer access
# to the GA4 property, base64-encoded.
GA_SERVICE_ACCOUNT_B64=

# The scheduler's secret. Vercel sends it to /api/webhooks/cron every ten minutes (vercel.json); without it the
# background sweep (open Vipps payments, old rate-limit counters) does not run. Any long random value:
# `openssl rand -hex 32`.
CRON_SECRET=
